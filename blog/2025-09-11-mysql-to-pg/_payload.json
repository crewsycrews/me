lass":124,"line":712},31,[122,714,715],{"class":140},"    --with-pgconfig=\u002Fusr\u002Fbin\u002Fpg_config \\\n",[122,717,719],{"class":124,"line":718},32,[122,720,721],{"class":140},"    --with-geosconfig=\u002Fusr\u002Fbin\u002Fgeos-config \\\n",[122,723,725],{"class":124,"line":724},33,[122,726,727],{"class":140},"    --with-projdir=\u002Fusr \\\n",[122,729,731],{"class":124,"line":730},34,[122,732,733],{"class":140},"    --with-gdalconfig=\u002Fusr\u002Fbin\u002Fgdal-config \\\n",[122,735,737],{"class":124,"line":736},35,[122,738,739],{"class":140},"    --with-jsondir=\u002Fusr \\\n",[122,741,743],{"class":124,"line":742},36,[122,744,745],{"class":140},"    --with-protobufdir=\u002Fusr && \\\n",[122,747,749],{"class":124,"line":748},37,[122,750,751],{"class":140},"    make && \\\n",[122,753,755],{"class":124,"line":754},38,[122,756,757],{"class":140},"    make install && \\\n",[122,759,761],{"class":124,"line":760},39,[122,762,763],{"class":140},"    cd \u002F && \\\n",[122,765,767],{"class":124,"line":766},40,[122,768,769],{"class":140},"    rm -rf \u002Ftmp\u002Fpostgis-*\n",[10,771,773],{"id":772},"процесс-переноса","Процесс переноса",[55,775,776],{},"Предварительно обкатав процесс в локальном окружении, я приступил к переносу на стендовых инстансах — stage и production.",[55,778,779],{},"Процесс выглядел так:",[781,782,783,786,792,803,812,818,821],"ol",{},[18,784,785],{},"Создаём инстанс RDS в облаке.",[18,787,788,789,42],{},"Подключаемся клиентом ",[66,790,791],{},"psql",[18,793,794,795,798,799,802],{},"Включаем расширения ",[66,796,797],{},"aws_commons"," и ",[66,800,801],{},"aws_s3",". Они нужны, чтобы использовать файлы из S3 для импорта CSV. Напомню: в RDS у нас нет доступа к файловой системе хоста БД.",[18,804,805,806,811],{},"Создаём ",[88,807,810],{"href":808,"rel":809},"https:\u002F\u002Fdocs.aws.amazon.com\u002Fvpc\u002Flatest\u002Fprivatelink\u002Fvpc-endpoints-s3.html",[92],"VPC Endpoint"," для доступа базы данных к S3.",[18,813,814,815,42],{},"Изменяем конфигурацию подключения к БД в Laravel — ",[66,816,817],{},"config\u002Fdatabase.php",[18,819,820],{},"Деплоим код с новой миграцией и применяем созданную нами схему к базе PostgreSQL.",[18,822,823],{},"Останавливаем приложение, чтобы исключить новые записи в БД:",[113,825,829],{"className":826,"code":827,"language":828,"meta":118,"style":118},"language-bash shiki shiki-themes github-light github-dark","php artisan down\n","bash",[66,830,831],{"__ignoreMap":118},[122,832,833,835,838],{"class":124,"line":125},[122,834,117],{"class":136},[122,836,837],{"class":144}," artisan",[122,839,840],{"class":144}," down\n",[55,842,843],{},"Эта команда включает maintenance mode.",[781,845,846],{"start":250},[18,847,848],{},"Делаем дамп CSV-файлов:",[113,850,852],{"className":826,"code":851,"language":828,"meta":118,"style":118},"mysqldump --port=3308 -u root -psecret db-name \\\n  --no-create-info \\\n  --fields-terminated-by=, \\\n  --tab=\u002Fvar\u002Flib\u002Fmysql-files \\\n  --fields-enclosed-by='\\\"' \\\n  --lines-terminated-by='\\n'\n",[66,853,854,877,884,891,898,908],{"__ignoreMap":118},[122,855,856,859,862,865,868,871,874],{"class":124,"line":125},[122,857,858],{"class":136},"mysqldump",[122,860,861],{"class":128}," --port=3308",[122,863,864],{"class":128}," -u",[122,866,867],{"class":144}," root",[122,869,870],{"class":128}," -psecret",[122,872,873],{"class":144}," db-name",[122,875,876],{"class":128}," \\\n",[122,878,879,882],{"class":124,"line":157},[122,880,881],{"class":128},"  --no-create-info",[122,883,876],{"class":128},[122,885,886,889],{"class":124,"line":169},[122,887,888],{"class":128},"  --fields-terminated-by=,",[122,890,876],{"class":128},[122,892,893,896],{"class":124,"line":175},[122,894,895],{"class":128},"  --tab=\u002Fvar\u002Flib\u002Fmysql-files",[122,897,876],{"class":128},[122,899,900,903,906],{"class":124,"line":182},[122,901,902],{"class":128},"  --fields-enclosed-by=",[122,904,905],{"class":144},"'\\\"'",[122,907,876],{"class":128},[122,909,910,913],{"class":124,"line":216},[122,911,912],{"class":128},"  --lines-terminated-by=",[122,914,915],{"class":144},"'\\n'\n",[55,917,918],{},"Это создаст отдельный файл для каждой существующей таблицы в БД. Например:",[113,920,925],{"className":921,"code":923,"language":924,"meta":118},[922],"language-text","actions.sql  actions.txt\nusers.sql    users.txt\n","text",[66,926,923],{"__ignoreMap":118},[55,928,929],{},"Параметры команды:",[15,931,932,938,944,954,968],{},[18,933,934,937],{},[66,935,936],{},"--no-create-info"," — отключаем генерацию схемы;",[18,939,940,943],{},[66,941,942],{},"--fields-terminated-by=,"," — разделитель-запятая;",[18,945,946,949,950,953],{},[66,947,948],{},"--tab=\u002Fvar\u002Flib\u002Fmysql-files"," — сохраняем файлы в ",[66,951,952],{},"\u002Fvar\u002Flib\u002Fmysql-files",". По умолчанию MySQL может экспортировать только в эту папку. Если её нет, нужно заранее создать вручную;",[18,955,956,959,960,963,964,967],{},[66,957,958],{},"--fields-enclosed-by='\\\"'"," — оборачиваем каждое значение в ",[66,961,962],{},"\\\"",". Именно такой формат ожидает ",[66,965,966],{},"COPY"," в PostgreSQL;",[18,969,970,973],{},[66,971,972],{},"--lines-terminated-by='\\n'"," — устанавливаем символ перевода строки.",[781,975,976,990],{"start":257},[18,977,978,979,982,983,42],{},"Переносим ",[66,980,981],{},".txt","-файлы в S3-бакет. Если вы, как и я, генерировали файлы внутри контейнера, вам поможет ",[88,984,987],{"href":985,"rel":986},"https:\u002F\u002Fdocs.docker.com\u002Freference\u002Fcli\u002Fdocker\u002Fcontainer\u002Fcp\u002F",[92],[66,988,989],{},"docker cp",[18,991,992,993,995],{},"Затем импортируем каждый файл в ",[66,994,791],{}," следующей командой — по одной на каждую таблицу:",[113,997,999],{"className":316,"code":998,"language":318,"meta":118,"style":118},"SELECT aws_s3.table_import_from_s3(\n  'users',\n  '',\n  '(format csv, header false, null ''\\N'', escape ''\\'')',\n  'db-name',\n  '\u002Fdumps\u002Fusers.txt',\n  'your-aws-region',\n  'AWS_ACCESS_KEY',\n  'AWS_SECRET_KEY',\n  ''\n);\n",[66,1000,1001,1017,1024,1031,1038,1045,1052,1059,1066,1073,1078],{"__ignoreMap":118},[122,1002,1003,1006,1009,1011,1014],{"class":124,"line":125},[122,1004,1005],{"class":132},"SELECT",[122,1007,1008],{"class":128}," aws_s3",[122,1010,42],{"class":140},[122,1012,1013],{"class":128},"table_import_from_s3",[122,1015,1016],{"class":140},"(\n",[122,1018,1019,1022],{"class":124,"line":157},[122,1020,1021],{"class":144},"  'users'",[122,1023,384],{"class":140},[122,1025,1026,1029],{"class":124,"line":169},[122,1027,1028],{"class":144},"  ''",[122,1030,384],{"class":140},[122,1032,1033,1036],{"class":124,"line":175},[122,1034,1035],{"class":144},"  '(format csv, header false, null ''\\N'', escape ''\\'')'",[122,1037,384],{"class":140},[122,1039,1040,1043],{"class":124,"line":182},[122,1041,1042],{"class":144},"  'db-name'",[122,1044,384],{"class":140},[122,1046,1047,1050],{"class":124,"line":216},[122,1048,1049],{"class":144},"  '\u002Fdumps\u002Fusers.txt'",[122,1051,384],{"class":140},[122,1053,1054,1057],{"class":124,"line":221},[122,1055,1056],{"class":144},"  'your-aws-region'",[122,1058,384],{"class":140},[122,1060,1061,1064],{"class":124,"line":250},[122,1062,1063],{"class":144},"  'AWS_ACCESS_KEY'",[122,1065,384],{"class":140},[122,1067,1068,1071],{"class":124,"line":257},[122,1069,1070],{"class":144},"  'AWS_SECRET_KEY'",[122,1072,384],{"class":140},[122,1074,1075],{"class":124,"line":280},[122,1076,1077],{"class":144},"  ''\n",[122,1079,1080],{"class":124,"line":591},[122,1081,213],{"class":140},[781,1083,1084],{"start":591},[18,1085,1086],{},"Запускаем приложение:",[113,1088,1090],{"className":826,"code":1089,"language":828,"meta":118,"style":118},"php artisan up\n",[66,1091,1092],{"__ignoreMap":118},[122,1093,1094,1096,1098],{"class":124,"line":125},[122,1095,117],{"class":136},[122,1097,837],{"class":144},[122,1099,1100],{"class":144}," up\n",[10,1102,1104],{"id":1103},"что-ещё-нужно-учесть","Что